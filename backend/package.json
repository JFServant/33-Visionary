{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "bun install && bun run env:local && bun run compose:up && bun run db:push:main && bun run db:push:test",
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "prune": "ts-prune -e -i src/01-infra/database/schema/index.ts",
    "lint": "eslint --fix .",
    "format": "prettier --write . --log-level error",
    "preflight": "bun run tsc && bun run prune && bun run lint && bun run format",
    "test": "bun test --preload ./spec.config.ts",
    "env:local": "cp .env.example .env",
    "env:ci": "cp .env.ci.example .env",
    "env:demo": "cp .env.demo.example .env",
    "docker:run": "docker build -t backend . && docker run -d -p 49321:49321 --name backend backend",
    "docker:stop": "docker stop backend && docker rm backend && docker rmi backend",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "docker:nuke": "docker system prune -a && docker volume prune -a",
    "db:generate": "bun run drizzle-kit generate --config=src/01-infra/database/main/drizzle.config.ts",
    "db:push:main": "bun run drizzle-kit push --config=src/01-infra/database/main/drizzle.config.ts",
    "db:push:test": "bun run drizzle-kit push --config=src/01-infra/database/test/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.891.0",
    "@aws-sdk/s3-request-presigner": "3.891.0",
    "argon2": "0.44.0",
    "bullmq": "5.58.5",
    "drizzle-orm": "0.44.4",
    "hono": "4.9.2",
    "ioredis": "5.7.0",
    "nanoid": "5.1.5",
    "pg": "8.16.3",
    "unique-names-generator": "4.7.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/bun": "latest",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "eslint": "9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "ts-prune": "0.10.3",
    "typescript-eslint": "8.39.1"
  }
}

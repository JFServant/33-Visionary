{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "bun install && bun run env",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prune": "ts-prune -p tsconfig.app.json -e",
    "lint": "eslint --fix .",
    "format": "prettier --write . --log-level error",
    "preflight": "bun run build && bun run prune && bun run lint && bun run format",
    "test": "vitest run",
    "env": "cp .env.example .env",
    "preview": "vite preview",
    "docker:run": "docker build -t frontend . && docker run -d -p 49432:80 --name frontend frontend",
    "docker:stop": "docker stop frontend && docker rm frontend && docker rmi frontend",
    "docker:nuke": "docker system prune -a && docker volume prune -a"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.8.2",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.0",
    "prettier": "^3.6.2",
    "ts-prune": "^0.10.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}

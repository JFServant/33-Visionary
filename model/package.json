{
  "name": "model",
  "type": "module",
  "scripts": {
    "setup": "npm i && npm run env",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prune": "ts-prune -e",
    "lint": "eslint --fix .",
    "format": "prettier --write . --log-level error",
    "preflight": "npm run build && npm run prune && npm run lint && npm run format",
    "test": "NODE_OPTIONS=--no-warnings node --loader ts-node/esm test-runner.ts",
    "env": "cp .env.example .env"
  },
  "dependencies": {
    "@hono/node-server": "1.19.4",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs-node": "4.22.0",
    "dotenv": "17.2.2",
    "hono": "4.9.8",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "20.11.17",
    "eslint": "9.36.0",
    "glob": "11.0.3",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "ts-prune": "0.10.3",
    "tsx": "4.7.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.44.1"
  }
}

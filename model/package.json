    "@types/node": "20.11.17",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "ts-prune": "0.10.3",
    "tsx": "4.7.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.44.1"
  }
